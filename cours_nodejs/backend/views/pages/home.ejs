    <p>Ceci est ma première page en EJS !</p>
    <h1><% 
        const safeNickname = typeof nickname !== 'undefined' ? nickname : null;
        const safeSex = typeof sex !== 'undefined' ? sex : null;
    %>

    <% if (safeNickname && safeNickname.trim() !== '') { %>
        <% if (safeSex === 'M') { %>
            Bonjour Mr <%= safeNickname %>
        <% } else if (safeSex === 'F') { %>
            Bonjour Mme <%= safeNickname %>
        <% } else { %>
            Bonjour <%= safeNickname %>
        <% } %>
    <% } else { %>
        <% if (safeSex === 'M') { %>
            Bonjour bel inconnu
        <% } else if (safeSex === 'F') { %>
            Bonjour belle inconnue
        <% } else { %>
            Bonjour bel(le) inconnu(e)
        <% } %>
    <% } %>
    </h1>

